./.next/dev/static/chunks/Projects_property-pulse-nextjs_805ee961._.js.map:    {"offset": {"line": 149, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/utils/applicationConstants.ts"],"sourcesContent":["export const CLOUDINARY_FOLDER='property-pulse';\nexport const amenityOptions = ['Wifi', 'Full kitchen', 'Washer & Dryer', 'Free Parking', 'Swimming Pool', 'Hot Tub', '24/7 Security', 'Wheelchair Accessible', 'Elevator Access', 'Dishwasher', 'Gym/Fitness Center', 'Air Conditioning', 'Balcony/Patio', 'Smart TV', 'Coffee Maker'];\nexport const PROPERTY_REACT_TOAST = {\n\tACTION_NAME: 'property-react-toast',\n\tMESSAGES :\t{\n\t\tCREATED_SUCCESSFUL: 'on-create-successful',\n\t\tUPDATED_SUCCESSFUL: 'on-update-successful'\n\t}\n};\n"],"names":[],"mappings":";;;;;;;;AAAO,MAAM,oBAAkB;AACxB,MAAM,iBAAiB;IAAC;IAAQ;IAAgB;IAAkB;IAAgB;IAAiB;IAAW;IAAiB;IAAyB;IAAmB;IAAc;IAAsB;IAAoB;IAAiB;IAAY;CAAe;AAC/Q,MAAM,uBAAuB;IACnC,aAAa;IACb,UAAW;QACV,oBAAoB;QACpB,oBAAoB;IACrB;AACD"}},
./.next/dev/static/chunks/Projects_property-pulse-nextjs_805ee961._.js.map:    {"offset": {"line": 189, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/utils/SuccessToast.ts"],"sourcesContent":["\"use client\";\n\nimport { useEffect, useRef } from \"react\";\nimport { useSearchParams, useRouter } from \"next/navigation\";\nimport { toast } from \"react-toastify\";\nimport { PROPERTY_REACT_TOAST } from \"./applicationConstants\";\n\nexport default function SuccessToast() {\n    const searchParams = useSearchParams();\n    const router = useRouter();\n    const hasShown = useRef(false); // prevents duplicate firing\n\n    const createdSuccessful = PROPERTY_REACT_TOAST.MESSAGES.CREATED_SUCCESSFUL;\n    const updatedSuccessful = PROPERTY_REACT_TOAST.MESSAGES.UPDATED_SUCCESSFUL;\n\n    useEffect(() => {\n        if (hasShown.current) return;\n\n        const toastMessages: Record<string, string> = {\n            [createdSuccessful]: \"Property created successfully!\",\n            [updatedSuccessful]: \"Property updated successfully!\",\n        };\n\n        const toastKey = searchParams.get(PROPERTY_REACT_TOAST.ACTION_NAME);\n\n        if (toastKey && toastMessages[toastKey]) {\n            hasShown.current = true; // mark as shown\n\n            toast.success(toastMessages[toastKey]);\n\n            // Remove query param safely\n            const newParams = new URLSearchParams(searchParams.toString());\n            newParams.delete(PROPERTY_REACT_TOAST.ACTION_NAME);\n\n            const queryString = newParams.toString();\n\n            router.replace(\n                `${window.location.pathname}${queryString ? `?${queryString}` : \"\"\n                }`,\n                { scroll: false }\n            );\n        }\n    }, [searchParams, router]);\n\n    return null;\n}\n"],"names":["c","_c","useEffect","useRef","useSearchParams","useRouter","toast","PROPERTY_REACT_TOAST","SuccessToast","$","$i","Symbol","for","searchParams","router","hasShown","createdSuccessful","MESSAGES","CREATED_SUCCESSFUL","updatedSuccessful","UPDATED_SUCCESSFUL","t0","t1","SuccessToast[useEffect()]","current","toastMessages","toastKey","get","ACTION_NAME","success","newParams","URLSearchParams","toString","delete","queryString","replace","window","location","pathname","scroll"],"mappings":";;;;AAAa,SAAAA,CAAA,IAAAC,EAAA;AAEb,SAASC,SAAS,EAAEC,MAAM,QAAQ,OAAO;AACzC,SAASC,eAAe,EAAEC,SAAS,QAAQ,iBAAiB;AAC5D,SAASC,KAAK,QAAQ,gBAAgB;AACtC,SAASC,oBAAoB,QAAQ,wBAAwB;;AAL7D,YAAY;;;;;;AAOG;;IAAA,MAAAE,CAAA,OAAAR,2NAAA,EAAA;IAAA,IAAAQ,CAAA,CAAA,EAAA,KAAA,oEAAA;QAAA,IAAA,IAAAC,EAAA,GAAA,GAAAA,EAAA,GAAA,GAAAA,EAAA,IAAA,EAAA;YAAAD,CAAA,CAAAC,EAAA,CAAA,GAAAC,MAAA,CAAAC,GAAA,CAAA;QAAA;QAAAH,CAAA,CAAA,EAAA,GAAA;IAAA;IACX,MAAAI,YAAA;IACA,MAAAC,MAAA;IACA,MAAAC,QAAA,OAAiBZ,kNAAM,EAAC,KAAK,CAAC;IAE9B,MAAAa,iBAAA,GAA0BT,mMAAoB,CAAAU,QAAS,CAAAC,kBAAmB;IAC1E,MAAAC,iBAAA,GAA0BZ,mMAAoB,CAAAU,QAAS,CAAAG,kBAAmB;IAAC,IAAAC,EAAA;IAAA,IAAAC,EAAA;IAAA,IAAAb,CAAA,CAAA,EAAA,KAAAK,MAAA,IAAAL,CAAA,CAAA,EAAA,KAAAI,YAAA,EAAA;QAEjEQ,EAAA,GAAA,CAAA;YAAA,6BAAAE,CAAA;gBACN,IAAIR,QAAQ,CAAAS,OAAQ,EAAA;oBAAA;gBAAA;gBAEpB,MAAAC,aAAA,GAA8C;oBAAA,CACzCT,iBAAiB,CAAA,EAAG,gCAAgC;oBAAA,CACpDG,iBAAiB,CAAA,EAAG;gBACzB,CAAC;gBAED,MAAAO,QAAA,GAAiBb,YAAY,CAAAc,GAAI,CAACpB,mMAAoB,CAAAqB,WAAY,CAAC;gBAEnE,IAAIF,QAAmC,IAAvBD,aAAa,CAACC,QAAQ,CAAC,EAAA;oBACnCX,QAAQ,CAAAS,OAAA,GAAW,IAAH;oBAEhBlB,0MAAK,CAAAuB,OAAQ,CAACJ,aAAa,CAACC,QAAQ,CAAC,CAAC;oBAGtC,MAAAI,SAAA,GAAkB,IAAIC,eAAe,CAAClB,YAAY,CAAAmB,QAAS,CAAC,CAAC,CAAC;oBAC9DF,SAAS,CAAAG,MAAO,CAAC1B,mMAAoB,CAAAqB,WAAY,CAAC;oBAElD,MAAAM,WAAA,GAAoBJ,SAAS,CAAAE,QAAS,CAAC,CAAC;oBAExClB,MAAM,CAAAqB,OAAQ,CACV,GAAGC,MAAM,CAAAC,QAAS,CAAAC,QAAS,GAAGJ,WAAW,GAAX,CAAA,CAAA,EAAkBA,WAAW,EAAO,GAApC,EAAoC,EAChE,EACF;wBAAAK,MAAA,EAAU;oBAAM,CACpB,CAAC;gBAAA;YACJ;SAAA,CAAA,CAAA,4BACJ;QAAEjB,EAAA,GAAA;YAACT,YAAY;YAAEC,MAAM;SAAC;QAAAL,CAAA,CAAA,EAAA,GAAAK,MAAA;QAAAL,CAAA,CAAA,EAAA,GAAAI,YAAA;QAAAJ,CAAA,CAAA,EAAA,GAAAY,EAAA;QAAAZ,CAAA,CAAA,EAAA,GAAAa,EAAA;IAAA,OAAA;QAAAD,EAAA,GAAAZ,CAAA,CAAA,EAAA;QAAAa,EAAA,GAAAb,CAAA,CAAA,EAAA;IAAA;QA3BzBP,qNAAS,EAACmB,EA2BT,EAAEC,EAAsB,CAAC;IAAA,OAEnB,IAAI;AAAA;;;QApCUlB,mMAAe,CAAC,CAAC;QACvBC,6LAAS,CAAC,CAAC;;;KAFfG,aAAA","ignoreList":[]}},
./.next/dev/static/chunks/Projects_property-pulse-nextjs_805ee961._.js.map:    {"offset": {"line": 275, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/app/actions/bookmarkProperty.ts"],"sourcesContent":["'use server';\n\nimport connectDB from \"@/config/database\";\nimport User from \"@/models/User\";\nimport { getSessionUser } from \"@/utils/getSessionUser\";\nimport { revalidatePath } from \"next/cache\";\n\nasync function bookmarkProperty(\n  propertyId: number | string\n): Promise<{\n  message: string;\n  isBookmarked: boolean;\n}> {\n    await connectDB();\n    const sessionUser = await getSessionUser();\n\n  if (!sessionUser || !sessionUser.userId) {\n    throw new Error(\"You must be logged in to bookmark a property.\");\n  }\n\n  const user = await User.findById(sessionUser.userId);\n\n  if (!user) {\n    throw new Error(\"User not found.\");\n  }\n\n  let message;\n  let isBookmarked = user.bookmarks.includes(propertyId);\n\n  if (isBookmarked) {\n    // Remove bookmark\n    user.bookmarks.pull(propertyId);\n    //Update Results\n    message = \"Bookmark Removed\";\n    isBookmarked = false;                                                                                                                                                                                                                                                                                                                                                                                                                     \n  } else {\n    // Add bookmark\n    user.bookmarks.push(propertyId);\n    //Update Results\n    message = \"Bookmark Added\";\n    isBookmarked = true;\n  }\n  //Now saving\n  await user.save();\n  revalidatePath('/properties/saved', 'page');\n  //Now return\n  return {\n    message,\n    isBookmarked\n  };\n}\n\nexport default bookmarkProperty;\n"],"names":[],"mappings":";;;;;;;2CAOe,6RAAA,EAAA,8CAAA,kRAAA,EAAA,KAAA,GAAA,wRAAA,EAAA"}},
./.next/dev/static/chunks/Projects_property-pulse-nextjs_805ee961._.js.map:    {"offset": {"line": 291, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/components/BookmarkButton.tsx"],"sourcesContent":["'use client';\nimport { useState, useEffect } from 'react';\nimport { FaBookmark } from \"react-icons/fa\";\nimport bookmarkProperty from \"@/app/actions/bookmarkProperty\";\nimport { toast } from \"react-toastify\";\nimport { useSession } from \"next-auth/react\";\n\ntype BookmarkButtonProps = {\n    property: {\n        _id: number | string;\n    }\n};\n\nconst BookmarkButton = ({ property }: BookmarkButtonProps) => {\n    const { _id: propertyId } = property;\n\n    const [isBookmarked, setBookmarked] = useState(false);\n    const [loading, setLoading] = useState(true);\n\n    const { data: session } = useSession();\n    const userId = session?.user?.id;\n\n    const handleClick = async () => {\n        if (!userId) {\n            toast.error('You are not signed in, you can not bookmark');\n            return;\n        }\n        bookmarkProperty(propertyId).then((res) => {\n            if (res.error) {\n                toast.error(res.error);\n                return;\n            }\n            toast.success(res.message);\n            setBookmarked(res.isBookmarked);\n        });\n    }\n    //if (loading) return (<p className=\"text-center\">Loading...</p>);\n    return isBookmarked ? (\n        <button\n            className=\"bg-red-500 hover:bg-red-600 text-white font-bold w-full py-2 px-4 rounded-full flex items-center justify-center cursor-pointer\"\n            onClick={handleClick}\n        >\n            <FaBookmark className=\"mr-2\" /> Remove Bookmark\n        </button>\n    ) : (\n        <button\n            className=\"bg-blue-500 hover:bg-blue-600 text-white font-bold w-full py-2 px-4 rounded-full flex items-center justify-center cursor-pointer\"\n            onClick={handleClick}\n        >\n            <FaBookmark className=\"mr-2\" /> Bookmark Property\n        </button>\n    );\n}\n\nexport default BookmarkButton;"],"names":["c","_c","useState","useEffect","FaBookmark","bookmarkProperty","toast","useSession","BookmarkButtonProps","property","_id","BookmarkButton","t0","$","$i","Symbol","for","propertyId","isBookmarked","setBookmarked","data","session","userId","user","id","t1","error","then","res","success","message","handleClick","t2"],"mappings":";;;;;AAAa,SAAAA,CAAA,IAAAC,EAAA;AACb,SAASC,QAAQ,EAAEC,SAAS,QAAQ,OAAO;AAC3C,SAASC,UAAU,QAAQ,gBAAgB;AAC3C,OAAOC,gBAAgB,MAAM,gCAAgC;AAC7D,SAASC,KAAK,QAAQ,gBAAgB;AACtC,SAASC,UAAU,QAAQ,iBAAiB;;;AAL5C,YAAY;;;;;;;AAaZ,wBAAuBK,EAAA;;IAAA,MAAAC,CAAA,OAAAZ,2NAAA,EAAA;IAAA,IAAAY,CAAA,CAAA,EAAA,KAAA,oEAAA;QAAA,IAAA,IAAAC,EAAA,GAAA,GAAAA,EAAA,GAAA,GAAAA,EAAA,IAAA,EAAA;YAAAD,CAAA,CAAAC,EAAA,CAAA,GAAAC,MAAA,CAAAC,GAAA,CAAA;QAAA;QAAAH,CAAA,CAAA,EAAA,GAAA;IAAA;IAAC,MAAA,EAAAJ,QAAAA,EAAA,GAAAG,EAAiC;IACrD,MAAA,EAAAF,GAAA,EAAAO,UAAAA,EAAA,GAA4BR,QAAQ;IAEpC,MAAA,CAAAS,YAAA,EAAAC,aAAA,CAAA,OAAsCjB,oNAAQ,EAAC,KAAK,CAAC;QACvBA,oNAAQ,EAAC,IAAI,CAAC;IAE5C,MAAA,EAAAkB,IAAA,EAAAC,OAAAA,EAAA;IACA,MAAAC,MAAA,GAAeD,OAAO,EAAAE,IAAU,EAAAC,EAAA;IAAC,IAAAC,EAAA;IAAA,IAAAZ,CAAA,CAAA,EAAA,KAAAI,UAAA,IAAAJ,CAAA,CAAA,EAAA,KAAAS,MAAA,EAAA;QAEbG,EAAA,GAAA,MAAAA,CAAA;YAChB,IAAI,CAACH,MAAM,EAAA;gBACPhB,0MAAK,CAAAoB,KAAM,CAAC,6CAA6C,CAAC;gBAAA;YAAA;gBAG9DrB,+MAAgB,EAACY,UAAU,CAAC,CAAAU,IAAK,EAACC,GAAA;gBAC9B,IAAIA,GAAG,CAAAF,KAAM,EAAA;oBACTpB,0MAAK,CAAAoB,KAAM,CAACE,GAAG,CAAAF,KAAM,CAAC;oBAAA;gBAAA;gBAG1BpB,0MAAK,CAAAuB,OAAQ,CAACD,GAAG,CAAAE,OAAQ,CAAC;gBAC1BX,aAAa,CAACS,GAAG,CAAAV,YAAa,CAAC;YAAA,CAClC,CAAC;QAAA,CACL;QAAAL,CAAA,CAAA,EAAA,GAAAI,UAAA;QAAAJ,CAAA,CAAA,EAAA,GAAAS,MAAA;QAAAT,CAAA,CAAA,EAAA,GAAAY,EAAA;IAAA,OAAA;QAAAA,EAAA,GAAAZ,CAAA,CAAA,EAAA;IAAA;IAbD,MAAAkB,WAAA,GAAoBN,EAanB;IAAA,IAAAO,EAAA;IAAA,IAAAnB,CAAA,CAAA,EAAA,KAAAkB,WAAA,IAAAlB,CAAA,CAAA,EAAA,KAAAK,YAAA,EAAA;QAEMc,EAAA,GAAAd,YAAY,iBACf,wOAAA,MAKS;YAJK,SAAgI,EAAhI,gIAAgI;YACjIa,OAAW,C