./.next/dev/static/chunks/Projects_property-pulse-nextjs_eb5e562c._.js.map:    {"offset": {"line": 52, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/components/Navbar.jsx"],"sourcesContent":["\"use client\";\nimport { useState } from \"react\";\nimport Link from \"next/link\";\nimport Image from \"next/image\";\nimport { FaGoogle } from \"react-icons/fa\";\nimport { usePathname } from \"next/navigation\";\nimport logo from \"@/assets/images/logo-white.png\";\nimport profileDefault from \"@/assets/images/profile.png\";\n\nconst Navbar = () => {\n  const [isMobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [isProfileMenuOpen, setProfileMenuOpen] = useState(false);\n  const [isLoggedIn, setLoggedIn] = useState(false);\n\n  const pathname = usePathname();\n\n  return (\n    <nav className=\"bg-blue-700 border-b border-blue-500\">\n      <div className=\"mx-auto max-w-7xl px-2 sm:px-6 lg:px-8\">\n        <div className=\"relative flex h-20 items-center justify-between\">\n          <div className=\"absolute inset-y-0 left-0 flex items-center md:hidden\">\n            {/* <!-- Mobile menu button--> */}\n            <button\n              type=\"button\"\n              id=\"mobile-dropdown-button\"\n              className=\"relative inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white\"\n              aria-controls=\"mobile-menu\"\n              aria-expanded=\"false\"\n              onClick={() => setMobileMenuOpen((prev) => !prev)}\n            >\n              <span className=\"absolute -inset-0.5\"></span>\n              <span className=\"sr-only\">Open main menu</span>\n              <svg\n                className=\"block h-6 w-6\"\n                fill=\"none\"\n                viewBox=\"0 0 24 24\"\n                strokeWidth=\"1.5\"\n                stroke=\"currentColor\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  d=\"M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5\"\n                />\n              </svg>\n            </button>\n          </div>\n\n          <div className=\"flex flex-1 items-center justify-center md:items-stretch md:justify-start\">\n            {/* <!-- Logo --> */}\n            <Link className=\"flex flex-shrink-0 items-center\" href=\"/\">\n              <Image className=\"h-10 w-auto\" src={logo} alt=\"PropertyPulse\" />\n\n              <span className=\"hidden md:block text-white text-2xl font-bold ml-2\">\n                PropertyPulse\n              </span>\n            </Link>\n            {/* <!-- Desktop Menu Hidden below md screens --> */}\n            <div className=\"hidden md:ml-6 md:block\">\n              <div className=\"flex space-x-2\">\n                <Link\n                  href=\"/\"\n                  className={`${\n                    pathname === \"/\" ? \"bg-black\" : \"\"\n                  } text-white hover:bg-gray-900 hover:text-white rounded-md px-3 py-2`}\n                >\n                  Home\n                </Link>\n                <Link\n                  href=\"/properties\"\n                  className={`${\n                    pathname === \"/properties\" ? \"bg-black\" : \"\"\n                  } text-white hover:bg-gray-900 hover:text-white rounded-md px-3 py-2`}\n                >\n                  Properties\n                </Link>\n                {isLoggedIn && (\n                  <Link\n                    href=\"/properties/add\"\n                    className={`${\n                      pathname === \"/properties/add\" ? \"bg-black\" : \"\"\n                    } text-white hover:bg-gray-900 hover:text-white rounded-md px-3 py-2`}\n                  >\n                    Add Property\n                  </Link>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {isLoggedIn ? (\n            /* <!-- Right Side Menu (Logged In) --> */\n            <div className=\"absolute inset-y-0 right-0 flex items-center pr-2 md:static md:inset-auto md:ml-6 md:pr-0\">\n              <Link href=\"/messages\" className=\"relative group\">\n                <button\n                  type=\"button\"\n                  className=\"relative rounded-full bg-gray-800 p-1 text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800\"\n                >\n                  <span className=\"absolute -inset-1.5\"></span>\n                  <span className=\"sr-only\">View notifications</span>\n                  <svg\n                    className=\"h-6 w-6\"\n                    fill=\"none\"\n                    viewBox=\"0 0 24 24\"\n                    strokeWidth=\"1.5\"\n                    stroke=\"currentColor\"\n                    aria-hidden=\"true\"\n                  >\n                    <path\n                      strokeLinecap=\"round\"\n                      strokeLinejoin=\"round\"\n                      d=\"M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0\"\n                    />\n                  </svg>\n                </button>\n                <span className=\"absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white transform translate-x-1/2 -translate-y-1/2 bg-red-600 rounded-full\">\n                  2\n                  {/* <!-- Replace with the actual number of notifications --> */}\n                </span>\n              </Link>\n              {/* <!-- Profile dropdown button --> */}\n              <div className=\"relative ml-3\">\n                <div>\n                  <button\n                    type=\"button\"\n                    className=\"relative flex rounded-full bg-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800\"\n                    id=\"user-menu-button\"\n                    aria-expanded=\"false\"\n                    aria-haspopup=\"true\"\n                    onClick={() => setProfileMenuOpen((prev) => !prev)}\n                  >\n                    <span className=\"absolute -inset-1.5\"></span>\n                    <span className=\"sr-only\">Open user menu</span>\n                    <Image\n                      className=\"h-8 w-8 rounded-full\"\n                      src={profileDefault}\n                      alt=\"\"\n                    />\n                  </button>\n                </div>\n\n                {/* <!-- Profile dropdown --> */}\n                {isProfileMenuOpen && (\n                  <div\n                    id=\"user-menu\"\n                    className=\"absolute right-0 z-10 mt-2 w-48 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none\"\n                    role=\"menu\"\n                    aria-orientation=\"vertical\"\n                    aria-labelledby=\"user-menu-button\"\n                    tabIndex=\"-1\"\n                  >\n                    <Link\n                      href=\"/profile\"\n                      className=\"block px-4 py-2 text-sm text-gray-700\"\n                      role=\"menuitem\"\n                      tabIndex=\"-1\"\n                      id=\"user-menu-item-0\"\n                    >\n                      Your Profile\n                    </Link>\n                    <Link\n                      href=\"/properties/saved\"\n                      className=\"block px-4 py-2 text-sm text-gray-700\"\n                      role=\"menuitem\"\n                      tabIndex=\"-1\"\n                      id=\"user-menu-item-2\"\n                    >\n                      Saved Properties\n                    </Link>\n                    <button\n                      className=\"block px-4 py-2 text-sm text-gray-700\"\n                      role=\"menuitem\"\n                      tabIndex=\"-1\"\n                      id=\"user-menu-item-2\"\n                    >\n                      Sign Out\n                    </button>\n                  </div>\n                )}\n              </div>\n            </div>\n          ) : (\n            /*<!-- Right Side Menu (Logged Out) --> */\n            <div className=\"hidden md:block md:ml-6\">\n              <div className=\"flex items-center\">\n                <button className=\"flex items-center text-white bg-gray-700 hover:bg-gray-900 hover:text-white rounded-md px-3 py-2\">\n                  <FaGoogle className=\"text-white mr-2\" />\n                  <span>Login or Register</span>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* <!-- Mobile menu, show/hide based on menu state. --> */}\n      {isMobileMenuOpen && (\n        <div id=\"mobile-menu\">\n          <div className=\"space-y-1 px-2 pb-3 pt-2\">\n            <Link\n              href=\"/\"\n              className={`${\n                pathname === \"/\" ? \"bg-black\" : \"\"\n              } text-white block rounded-md px-3 py-2 text-base font-medium`}\n            >\n              Home\n            </Link>\n            <Link\n              href=\"/properties\"\n              className={`${\n                pathname === \"/properties\" ? \"bg-black\" : \"\"\n              } text-white block rounded-md px-3 py-2 text-base font-medium`}\n            >\n              Properties\n            </Link>\n            {isLoggedIn && (\n              <Link\n                href=\"/properties/add\"\n                className={`${\n                  pathname === \"/properties/add\" ? \"bg-black\" : \"\"\n                } text-white block rounded-md px-3 py-2 text-base font-medium`}\n              >\n                Add Property\n              </Link>\n            )}\n            {!isLoggedIn && (\n              <button className=\"flex items-center text-white bg-gray-700 hover:bg-gray-900 hover:text-white rounded-md px-3 py-2 my-5\">\n                <FaGoogle className=\"text-white mr-2\" />\n                <span>Login or Register</span>\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n    </nav>\n  );\n};\n\nexport default Navbar;\n"],"names":["c","_c","useState","Link","Image","FaGoogle","usePathname","logo","profileDefault","Navbar","$","$i","Symbol","for","isMobileMenuOpen","setMobileMenuOpen","isProfileMenuOpen","setProfileMenuOpen","isLoggedIn","pathname","t0","t1","t2","_temp","t3","t4","t5","t6","t7","t8","t9","t10","t11","_temp2","t12","t13","t14","prev","prev_0"],"mappings":";;;;;AAAa,SAAAA,CAAA,IAAAC,EAAA;AACb,SAASC,QAAQ,QAAQ,OAAO;AAChC,OAAOC,IAAI,MAAM,WAAW;AAC5B,OAAOC,KAAK,MAAM,YAAY;AAC9B,SAASC,QAAQ,QAAQ,gBAAgB;AACzC,SAASC,WAAW,QAAQ,iBAAiB;AAC7C,OAAOC,IAAI,MAAM,gCAAgC;AACjD,OAAOC,cAAc,MAAM,6BAA6B;;;AAPxD,YAAY;;;;;;;;;AASZ,eAAeC,CAAA;;IAAA,MAAAC,CAAA,GAAAT,+NAAA,EAAA;IAAA,IAAAS,CAAA,CAAA,EAAA,KAAA,oEAAA;QAAA,IAAA,IAAAC,EAAA,GAAA,GAAAA,EAAA,GAAA,IAAAA,EAAA,IAAA,EAAA;YAAAD,CAAA,CAAAC,EAAA,CAAA,GAAAC,MAAA,CAAAC,GAAA,CAAA;QAAA;QAAAH,CAAA,CAAA,EAAA,GAAA;IAAA;IACb,MAAA,CAAAI,gBAAA,EAAAC,iBAAA,CAAA,OAA8Cb,oNAAQ,EAAC,KAAK,CAAC;IAC7D,MAAA,CAAAc,iBAAA,EAAAC,kBAAA,CAAA,OAAgDf,oNAAQ,EAAC,KAAK,CAAC;IAC/D,MAAA,CAAAgB,UAAA,CAAA,OAAkChB,oNAAQ,EAAC,KAAK,CAAC;IAEjD,MAAAiB,QAAA;IAA+B,IAAAC,EAAA;IAAA,IAAAC,EAAA;IAAA,IAAAC,EAAA;IAAA,IAAAZ,CAAA,CAAA,EAAA,KAAAE,MAAA,CAAAC,GAAA,CAAA,8BAAA;QAcVO,EAAA,GAAAA,CAAA,GAAML,iBAAiB,CAACQ,KAAe,CAAC;QAEjDF,EAAA,iBAAA,wOAAA,IAA6C;YAA7B,SAAqB,EAArB,qBAAqB,GAAQ;;;;;;QAC7CC,EAAA,iBAAA,wOAAA,IAA+C;YAA/B,SAAS,EAAT,SAAS;sBAAC,cAAc,EAAxC,IAA+C;;;;;;QAAAZ,CAAA,CAAA,EAAA,GAAAU,EAAA;QAAAV,CAAA,CAAA,EAAA,GAAAW,