 url += (~url.indexOf('?') ? '&' : '?') + param + '=' + enc(id);\n  url = url.replace('?&', '?');\n\n  debug('jsonp req \"%s\"', url);\n\n  // create script\n  script = document.createElement('script');\n  script.src = url;\n  target.parentNode.insertBefore(script, target);\n\n  return cancel;\n}\n"],"names":[],"mappings":"AAAA;;CAEC,GAED,IAAI,QAAQ,gIAAiB;AAE7B;;CAEC,GAED,OAAO,OAAO,GAAG;AAEjB;;CAEC,GAED,IAAI,QAAQ;AAEZ;;CAEC,GAED,SAAS,QAAO;AAEhB;;;;;;;;;;;;CAYC,GAED,SAAS,MAAM,GAAG,EAAE,IAAI,EAAE,EAAE;IAC1B,IAAI,cAAc,OAAO,MAAM;QAC7B,KAAK;QACL,OAAO,CAAC;IACV;IACA,IAAI,CAAC,MAAM,OAAO,CAAC;IAEnB,IAAI,SAAS,KAAK,MAAM,IAAI;IAE5B,6DAA6D;IAC7D,gEAAgE;IAChE,IAAI,KAAK,KAAK,IAAI,IAAK,SAAU;IAEjC,IAAI,QAAQ,KAAK,KAAK,IAAI;IAC1B,IAAI,UAAU,QAAQ,KAAK,OAAO,GAAG,KAAK,OAAO,GAAG;IACpD,IAAI,MAAM;IACV,IAAI,SAAS,SAAS,oBAAoB,CAAC,SAAS,CAAC,EAAE,IAAI,SAAS,IAAI;IACxE,IAAI;IACJ,IAAI;IAGJ,IAAI,SAAS;QACX,QAAQ,WAAW;YACjB;YACA,IAAI,IAAI,GAAG,IAAI,MAAM;QACvB,GAAG;IACL;IAEA,SAAS;QACP,IAAI,OAAO,UAAU,EAAE,OAAO,UAAU,CAAC,WAAW,CAAC;QACrD,MAAM,CAAC,GAAG,GAAG;QACb,IAAI,OAAO,aAAa;IAC1B;IAEA,SAAS;QACP,IAAI,MAAM,CAAC,GAAG,EAAE;YACd;QACF;IACF;IAEA,MAAM,CAAC,GAAG,GAAG,SAAS,IAAI;QACxB,MAAM,aAAa;QACnB;QACA,IAAI,IAAI,GAAG,MAAM;IACnB;IAEA,mBAAmB;IACnB,OAAO,CAAC,CAAC,IAAI,OAAO,CAAC,OAAO,MAAM,GAAG,IAAI,QAAQ,MAAM,IAAI;IAC3D,MAAM,IAAI,OAAO,CAAC,MAAM;IAExB,MAAM,kBAAkB;IAExB,gBAAgB;IAChB,SAAS,SAAS,aAAa,CAAC;IAChC,OAAO,GAAG,GAAG;IACb,OAAO,UAAU,CAAC,YAAY,CAAC,QAAQ;IAEvC,OAAO;AACT","ignoreList":[0]}},
