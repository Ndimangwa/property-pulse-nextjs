./.next/dev/static/chunks/Projects_property-pulse-nextjs_3a09752b._.js.map:    {"offset": {"line": 70, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/components/Navbar.tsx"],"sourcesContent":["\"use client\";\nimport { useState, useEffect } from \"react\";\nimport Link from \"next/link\";\nimport Image from \"next/image\";\nimport { usePathname } from \"next/navigation\";\nimport { signIn, signOut, useSession, getProviders } from 'next-auth/react';\nimport providerIcons from \"@/utils/providerIcons\";\nimport logo from \"@/assets/images/logo-white.png\";\nimport profileDefault from \"@/assets/images/profile.png\";\n\ntype ProviderProp = {\n  id: string;\n  name: string;\n  callbackUrl: string;\n  signinUrl: string;\n};\ntype ProvidersProp = ProviderProp[];\nconst Navbar = () => {\n  const { data: session } = useSession(); //naming data as session\n  //console.log(session);\n  const [isMobileMenuOpen, setMobileMenuOpen] = useState<boolean>(false);\n  const [isProfileMenuOpen, setProfileMenuOpen] = useState<boolean>(false);\n  const [providers, setProviders] = useState<ProvidersProp | null>(null);\n  //const { callbackUrl, id, name, signinUrl, type } = provider\n  const profileImage = session?.user?.image;\n  //console.log(profileImage);\n\n  const pathname = usePathname();\n\n  useEffect(() => {\n    //componentDidMount\n    const setAuthProviders = async () => {\n      const res = await getProviders();\n      setProviders(res);\n    }\n    setAuthProviders();\n  }, []);\n  return (\n    <nav className=\"bg-blue-700 border-b border-blue-500\">\n      <div className=\"mx-auto max-w-7xl px-2 sm:px-6 lg:px-8\">\n        <div className=\"relative flex h-20 items-center justify-between\">\n          <div className=\"absolute inset-y-0 left-0 flex items-center md:hidden\">\n            {/* <!-- Mobile menu button--> */}\n            <button\n              type=\"button\"\n              id=\"mobile-dropdown-button\"\n              className=\"relative inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white\"\n              aria-controls=\"mobile-menu\"\n              aria-expanded=\"false\"\n              onClick={() => setMobileMenuOpen((prev) => !prev)}\n            >\n              <span className=\"absolute -inset-0.5\"></span>\n              <span className=\"sr-only\">Open main menu</span>\n              <svg\n                className=\"block h-6 w-6\"\n                fill=\"none\"\n                viewBox=\"0 0 24 24\"\n                strokeWidth=\"1.5\"\n                stroke=\"currentColor\"\n                aria-hidden=\"true\"\n              >\n                <path\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  d=\"M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5\"\n                />\n              </svg>\n            </button>\n          </div>\n\n          <div className=\"flex flex-1 items-center justify-center md:items-stretch md:justify-start\">\n            {/* <!-- Logo --> */}\n            <Link className=\"flex flex-shrink-0 items-center\" href=\"/\">\n              <Image className=\"h-10 w-auto\" src={logo} alt=\"PropertyPulse\" />\n\n              <span className=\"hidden md:block text-white text-2xl font-bold ml-2\">\n                PropertyPulse\n              </span>\n            </Link>\n            {/* <!-- Desktop Menu Hidden below md screens --> */}\n            <div className=\"hidden md:ml-6 md:block\">\n              <div className=\"flex space-x-2\">\n                <Link\n                  href=\"/\"\n                  className={`${pathname === \"/\" ? \"bg-black\" : \"\"\n                    } text-white hover:bg-gray-900 hover:text-white rounded-md px-3 py-2`}\n                >\n                  Home\n                </Link>\n                <Link\n                  href=\"/properties\"\n                  className={`${pathname === \"/properties\" ? \"bg-black\" : \"\"\n                    } text-white hover:bg-gray-900 hover:text-white rounded-md px-3 py-2`}\n                >\n                  Properties\n                </Link>\n                {session && (\n                  <Link\n                    href=\"/properties/add\"\n                    className={`${pathname === \"/properties/add\" ? \"bg-black\" : \"\"\n                      } text-white hover:bg-gray-900 hover:text-white rounded-md px-3 py-2`}\n                  >\n                    Add Property\n                  </Link>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {session ? (\n            /* <!-- Right Side Menu (Logged In) --> */\n            <div className=\"absolute inset-y-0 right-0 flex items-center pr-2 md:static md:inset-auto md:ml-6 md:pr-0\">\n              <Link href=\"/messages\" className=\"relative group\">\n                <button\n                  type=\"button\"\n                  className=\"relative rounded-full bg-gray-800 p-1 text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800\"\n                >\n                  <span className=\"absolute -inset-1.5\"></span>\n                  <span className=\"sr-only\">View notifications</span>\n                  <svg\n                    className=\"h-6 w-6\"\n                    fill=\"none\"\n                    viewBox=\"0 0 24 24\"\n                    strokeWidth=\"1.5\"\n                    stroke=\"currentColor\"\n                    aria-hidden=\"true\"\n                  >\n                    <path\n                      strokeLinecap=\"round\"\n                      strokeLinejoin=\"round\"\n                      d=\"M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0\"\n                    />\n                  </svg>\n                </button>\n                <span className=\"absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white transform translate-x-1/2 -translate-y-1/2 bg-red-600 rounded-full\">\n                  2\n                  {/* <!-- Replace with the actual number of notifications --> */}\n                </span>\n              </Link>\n              {/* <!-- Profile dropdown button --> */}\n              <div className=\"relative ml-3\">\n                <div>\n                  <button\n                    type=\"button\"\n                    className=\"relative flex rounded-full bg-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800\"\n                    id=\"user-menu-button\"\n                    aria-expanded=\"false\"\n                    aria-haspopup=\"true\"\n                    onClick={() => setProfileMenuOpen((prev) => !prev)}\n                  >\n                    <span className=\"absolute -inset-1.5\"></span>\n                    <span className=\"sr-only\">Open user menu</span>\n                    <Image\n                      className=\"h-8 w-8 rounded-full\"\n                      src={profileImage || profileDefault}\n                      width={40}\n                      height={40}\n                      alt=\"\"\n                    />\n                  </button>\n                </div>\n\n                {/* <!-- Profile dropdown --> */}\n                {isProfileMenuOpen && (\n                  <div\n                    id=\"user-menu\"\n                    className=\"absolute right-0 z-10 mt-2 w-48 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none\"\n                    role=\"menu\"\n                    aria-orientation=\"vertical\"\n                    aria-labelledby=\"user-menu-button\"\n                    tabIndex=\"-1\"\n                  >\n                    <Link\n                      href=\"/profile\"\n                      className=\"block px-4 py-2 text-sm text-gray-700\"\n                      role=\"menuitem\"\n                      tabIndex=\"-1\"\n                      id=\"user-menu-item-0\"\n                      onClick={() => setProfileMenuOpen(false)}\n                    >\n                      Your Profile\n                    </Link>\n                    <Link\n                      href=\"/properties/saved\"\n                      className=\"block px-4 py-2 text-sm text-gray-700\"\n                      role=\"menuitem\"\n                      tabIndex=\"-1\"\n                      id=\"user-menu-item-2\"\n                      onClick={() => setProfileMenuOpen(false)}\n                    >\n                      Saved Properties\n                    </Link>\n                    <button\n                      className=\"block px-4 py-2 text-sm text-gray-700\"\n                      onClick={() => {\n                        setProfileMenuOpen(false);\n                        signOut();\n                      }}\n                      role=\"menuitem\"\n                      tabIndex=\"-1\"\n                      id=\"user-menu-item-2\"\n                    >\n                      Sign Out\n                    </button>\n                  </div>\n                )}\n              </div>\n            </div>\n          ) : (\n            /*<!-- Right Side Menu (Logged Out) --> */\n            <div className=\"hidden md:block md:ml-6\">\n              <div className=\"flex items-center\">\n                {providers && Object.values(providers).map((provider, index) => {\n                  const Icon = providerIcons[provider.id];\n                  return (\n                    <button\n                      key={index}\n                      onClick={() => signIn(provider.id)}\n                      className=\"relative group flex items-center text-white bg-gray-700 mr-2 hover:bg-gray-900 hover:text-white rounded-md px-3 py-2\">\n                      {Icon && <Icon className=\"text-white mr-2\" />}\n                      <span>Login or Register</span>\n                      {/*Tooltip*/}\n                      <span className=\"pointer-events-none absolute top-full left-1/2 -translate-x-1/2\n             mt-2 hidden group-hover:block z-50\n             bg-black text-white text-xs rounded px-2 py-1 whitespace-nowrap\">\n                        Sign in with {provider.name}\n                      </span>\n\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* <!-- Mobile menu, show/hide based on menu state. --> */}\n      {isMobileMenuOpen && (\n        <div id=\"mobile-menu\" className=\"md:hidden\">\n          <div className=\"space-y-1 px-2 pb-3 pt-2\">\n            <Link\n              href=\"/\"\n              className={`${pathname === \"/\" ? \"bg-black\" : \"\"\n                } text-white block rounded-md px-3 py-2 text-base font-medium`}\n            >\n              Home\n            </Link>\n            <Link\n              href=\"/properties\"\n              className={`${pathname === \"/properties\" ? \"bg-black\" : \"\"\n                } text-white block rounded-md px-3 py-2 text-base font-medium`}\n            >\n              Properties\n            </Link>\n            {session && (\n              <Link\n                href=\"/properties/add\"\n                className={`${pathname === \"/properties/add\" ? \"bg-black\" : \"\"\n                  } text-white block rounded-md px-3 py-2 text-base font-medium`}\n              >\n                Add Property\n              </Link>\n            )}\n            {!session && providers && Object.values(providers).map((provider) => {\n              const Icon = providerIcons[provider.id];\n              return (\n                <button className=\"relative group flex items-center text-white bg-gray-700 hover:bg-gray-900 hover:text-white rounded-md px-3 py-2 my-5\">\n                  {Icon && <Icon className=\"text-white mr-2\" />}\n                  <span>Login or Register</span>\n                  {/*Tooltip*/}\n                  <span className=\"pointer-events-none absolute top-full left-1/2 -translate-x-1/2\n             mt-2 hidden group-hover:block z-50\n             bg-black text-white text-xs rounded px-2 py-1 whitespace-nowrap\">\n                    Sign in with {provider.name}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      )}\n    </nav>\n  );\n};\n\nexport default Navbar;\n"],"names":["c","_c","useState","useEffect","Link","Image","usePathname","signIn","signOut","useSession","getProviders","providerIcons","logo","profileDefault","ProviderProp","id","name","callbackUrl","signinUrl","ProvidersProp","Navbar","$","$i","Symbol","for","data","session","isMobileMenuOpen","setMobileMenuOpen","isProfileMenuOpen","setProfileMenuOpen","providers","setProviders","profileImage","user","image","pathname","t0","t1","setAuthProviders","res","t2","t3","t4","_temp","t5","t6","t7","t8","t9","t10","t11","t12","t13","_temp2","Object","values","map","_temp3","t14","t15","_temp4","t16","prev","prev_0","provider","index","Icon","provider_0","Icon_0"],"mappings":";;;;;AAAa,SAAAA,CAAA,IAAAC,EAAA;AACb,SAASC,QAAQ,EAAEC,SAAS,QAAQ,OAAO;AAC3C,OAAOC,IAAI,MAAM,WAAW;AAC5B,OAAOC,KAAK,MAAM,YAAY;AAC9B,SAASC,WAAW,QAAQ,iBAAiB;AAC7C,SAASC,MAAM,EAAEC,OAAO,EAAEC,UAAU,EAAEC,YAAY,QAAQ,iBAAiB;AAC3E,OAAOC,aAAa,MAAM,uBAAuB;AACjD,OAAOC,IAAI,MAAM,gCAAgC;AACjD,OAAOC,cAAc,MAAM,6BAA6B;;;AARxD,YAAY;;;;;;;;;;AAiBZ,eAAeO,CAAA;;IAAA,MAAAC,CAAA,GAAApB,+NAAA,EAAA;IAAA,IAAAoB,CAAA,CAAA,EAAA,KAAA,oEAAA;QAAA,IAAA,IAAAC,EAAA,GAAA,GAAAA,EAAA,GAAA,IAAAA,EAAA,IAAA,EAAA;YAAAD,CAAA,CAAAC,EAAA