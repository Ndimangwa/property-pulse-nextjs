./.next/dev/static/chunks/Projects_property-pulse-nextjs_4d6bfff9._.js.map:    {"offset": {"line": 179, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/components/PropertyMap.tsx"],"sourcesContent":["\"use client\";\nimport { useEffect, useState, useRef } from 'react';\nimport { convertToSerializableObject } from \"@/utils/convertToObject\";\nimport getGeocodeAddress from '@/utils/getGeocodeAddress';\nimport Mapbox from '@/utils/Mapbox';\n\ntype PropertyMapProps = {\n    property: {\n        location: {\n            street: string;\n            city: string;\n            state: string;\n            zipcode: string;\n        }\n    }\n};\nconst PropertyMap = ({ property }: PropertyMapProps) => {\n    property = convertToSerializableObject(property);\n    const { location: { street, city, state, zipcode } } = property;\n    const [lat, setLat] = useState(null);\n    const [lng, setLng] = useState(null);\n    const [viewport, setViewport] = useState({\n        latitude: 0,\n        longitude: 0,\n        zoom: 12,\n        width: '100%',\n        height: '500px'\n    });\n    const [loading, setLoading] = useState(true);\n    const [geocodeError, setGeocodeError] = useState(false);\n    const hasShown = useRef(false);\n    useEffect(() => {\n        if (hasShown.current) return;\n        const fetchCoords = async () => {\n            try {\n                const result = await getGeocodeAddress(`${street} ${city} ${state} ${zipcode}`);\n                if (!result) {\n                    setGeocodeError(true);\n                    return;\n                }\n                const { lat, lng } = result;\n                console.log(lat, lng);\n                setLat(lat);\n                setLng(lng);\n                setViewport({\n                    ...viewport,\n                    latitude: lat,\n                    longitude: lng\n                });\n            } catch (err) {\n                console.log(err);\n                setGeocodeError(true);\n            } finally {\n                setLoading(false);\n                hasShown.current = true;\n            }\n        };\n        fetchCoords();\n    }, []);\n\n    if (loading) return <h3>Loading ....</h3>;\n    if (geocodeError) return <div className=\"text-xl\">No location data found</div>\n    return (\n        ! loading && (\n            <div className=\"w-full h-96\">\n                <Mapbox location={{ lat, lng }} />\n            </div>\n        )\n    );\n}\n\nexport default PropertyMap;"],"names":["useEffect","useState","useRef","convertToSerializableObject","getGeocodeAddress","Mapbox","PropertyMapProps","property","location","street","city","state","zipcode","PropertyMap","lat","setLat","lng","setLng","viewport","setViewport","latitude","longitude","zoom","width","height","loading","setLoading","geocodeError","setGeocodeError","hasShown","current","fetchCoords","result","console","log","err"],"mappings":";;;;;AACA,SAASA,SAAS,EAAEC,QAAQ,EAAEC,MAAM,QAAQ,OAAO;AACnD,SAASC,2BAA2B,QAAQ,yBAAyB;AACrE,OAAOC,iBAAiB,MAAM,2BAA2B;AACzD,OAAOC,MAAM,MAAM,gBAAgB;;;AAJnC,YAAY;;;;;AAgBZ,oBAAoBQ,CAAC,EAAEN,QAAAA,EAA4B,KAAK;;IACpDA,QAAQ,OAAGJ,qMAA2B,EAACI,QAAQ,CAAC;IAChD,MAAM,EAAEC,QAAQ,EAAE,EAAEC,MAAM,EAAEC,IAAI,EAAEC,KAAK,EAAEC,OAAAA,EAAQ,EAAG,GAAGL,QAAQ;IAC/D,MAAM,CAACO,GAAG,EAAEC,MAAM,CAAC,GAAGd,wNAAQ,EAAC,IAAI,CAAC;IACpC,MAAM,CAACe,GAAG,EAAEC,MAAM,CAAC,OAAGhB,oNAAQ,EAAC,IAAI,CAAC;IACpC,MAAM,CAACiB,QAAQ,EAAEC,WAAW,CAAC,OAAGlB,oNAAQ,EAAC;QACrCmB,QAAQ,EAAE,CAAC;QACXC,SAAS,EAAE,CAAC;QACZC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,MAAM;QACbC,MAAM,EAAE;IACZ,CAAC,CAAC;IACF,MAAM,CAACC,OAAO,EAAEC,UAAU,CAAC,OAAGzB,oNAAQ,EAAC,IAAI,CAAC;IAC5C,MAAM,CAAC0B,YAAY,EAAEC,eAAe,CAAC,OAAG3B,oNAAQ,EAAC,KAAK,CAAC;IACvD,MAAM4B,QAAQ,OAAG3B,kNAAM,EAAC,KAAK,CAAC;QAC9BF,qNAAS;iCAAC,MAAM;YACZ,IAAI6B,QAAQ,CAACC,OAAO,EAAE;YACtB,MAAMC,WAAW;qDAAG,MAAAA,CAAA,KAAY;oBAC5B,IAAI;wBACA,MAAMC,MAAM,GAAG,UAAM5B,mLAAiB,EAAC,GAAGK,MAAM,CAAA,CAAA,EAAIC,IAAI,CAAA,CAAA,EAAIC,KA