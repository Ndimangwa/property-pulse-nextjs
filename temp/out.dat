./.next/dev/static/chunks/Projects_property-pulse-nextjs_3a09752b._.js.map:    {"offset": {"line": 4, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/utils/providerIcons.ts"],"sourcesContent":["import { FaGoogle, FaGithub } from 'react-icons/fa';\nimport type { IconType } from 'react-icons';\n\nconst providerIcons : Record<string, IconType> = {\n    google: FaGoogle,\n    github: FaGithub\n}\nexport default providerIcons;"],"names":[],"mappings":";;;;AAAA;;AAGA,MAAM,gBAA2C;IAC7C,QAAQ,wMAAQ;IAChB,QAAQ,wMAAQ;AACpB;uCACe"}},
