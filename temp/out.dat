./.next/dev/static/chunks/Projects_property-pulse-nextjs_components_ProfileProperties_tsx_f13f1244._.js.map:    {"offset": {"line": 4, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/components/ProfileProperties.tsx"],"sourcesContent":["'use client';\nimport { useState } from 'react';\nimport Image from 'next/image';\nimport Link from 'next/link';\nimport deleteProperty from '@/app/actions/deleteProperty';\n\ntype ProfilePropertiesProps = {\n    properties: {\n        _id: number | string;\n        name: string;\n        images: string[];\n        location: {\n            street: string;\n            city: string;\n            state: string;\n        };\n    }[];\n};\nconst ProfileProperties = ({ properties: initialProperties }: ProfilePropertiesProps) => {\n    const [properties, setProperties] = useState(initialProperties);\n    const handleDeleteProperty = async (propertyId: string) => {\n\n    }\n    return properties.map((property, index) => {\n        const { _id, name, images, location: { street, city, state } } = property;\n        return (\n            <div key={index} className=\"mb-10\">\n                <Link href={`properties/${_id}`}>\n                    <Image\n                        className=\"h-32 w-full rounded-md object-cover\"\n                        src={images[0]}\n                        alt=\"Property 1\"\n                        width={1000}\n                        height={200}\n                    />\n                </Link>\n                <div className=\"mt-2\">\n                    <p className=\"text-lg font-semibold\">{name}</p>\n                    <p className=\"text-gray-600\">Address: {street} {city},  {state}</p>\n                </div>\n                <div className=\"mt-2\">\n                    <Link\n                        href=\"properties/add\"\n                        className=\"bg-blue-500 text-white px-3 py-3 rounded-md mr-2 hover:bg-blue-600\"\n                    >\n                        Edit\n                    </Link>\n                    <button\n                        className=\"bg-red-500 text-white px-3 py-2 rounded-md hover:bg-red-600\"\n                        type=\"button\"\n                    >\n                        Delete\n                    </button>\n                </div>\n            </div>\n        );\n    });\n}\n\nexport default ProfileProperties;"],"names":["c","_c","useState","Image","Link","deleteProperty","ProfilePropertiesProps","properties","_id","name","images","location","street","city","state","ProfileProperties","t0","$","$i","Symbol","for","initialProperties","t1","map","_temp","property","index"],"mappings":";;;;;AAAa,SAAAA,CAAA,IAAAC,EAAA;AACb,SAASC,QAAQ,QAAQ,OAAO;AAChC,OAAOC,KAAK,MAAM,YAAY;AAC9B,OAAOC,IAAI,MAAM,WAAW;;;AAH5B,YAAY;;;;;AAkBZ,2BAA0BY,EAAA;;IAAA,MAAAC,CAAA,OAAAhB,2NAAA,EAAA;IAAA,IAAAgB,CAAA,CAAA,EAAA,KAAA,oEAAA;QAAA,IAAA,IAAAC,EAAA,GAAA,GAAAA,EAAA,GAAA,GAAAA,EAAA,IAAA,EAAA;YAAAD,CAAA,CAAAC,EAAA,CAAA,GAAAC,MAAA,CAAAC,GAAA,CAAA;QAAA;QAAAH,CAAA,CAAA,EAAA,GAAA;IAAA;IAAC,MAAA,EAAAV,UAAA,EAAAc,iBAAAA,EAAA,GAAAL,EAAyD;IAChF,MAAA,CAAAT,UAAA,CAAA,OAAoCL,oNAAQ,EAACmB,iBAAiB,CAAC;IAAC,IAAAC,EAAA;IAAA,IAAAL,CAAA,CAAA,EAAA,KAAAV,UAAA,EAAA;QAIzDe,EAAA,GAAAf,UAAU,CAAAgB,GAAI,CAACC,KAiCrB,CAAC;QAAAP,CAAA,CAAA,EAAA,GAAAV,UAAA;QAAAU,CAAA,CAAA,EAAA,GAAAK,EAAA;IAAA,OAAA;QAAAA,EAAA,GAAAL,CAAA,CAAA,EAAA;IAAA;IAAA,OAjCKK,EAiCL;AAAA,CACL;;KAvCKP,iBAAiB;uCAyCRA,iBAAiB;AAzCN,SAAAS,MAAAC,QAAA,EAAAC,KAAA;IAMlB,MAAA,EAAAlB,GAAA,EAAAC,IAAA,EAAAC,MAAA,EAAAC,QAAA,EAAAK,EAAAA,EAAA,GAAiES,QAAQ;IAApC,MAAA,EAAAb,MAAA,EAAAC,IAAA,EAAAC,KAAAA,EAAA,GAAAE,EAAuB;IAAA,qBAExD,wOAAA,GA4BM,CA5BIU,GAAK,CAALA;QAAiB,SAAO,EAAP,OAAO;;0BAC9B,wOAAC,qNAAI;gBAAO,IAAmB,CAAnB,CAAA,CAAA,WAAA,EAAclB,GAAG,EAAC,CAAC;wCAC3B,wOAAC,sLAAK;oBACQ,SAAqC,EAArC,qCAAqC;oBAC1C,GAAS,CAAT,CAAAE,MAAM,CAAA,EAAE,CAAC;oBACV,GAAY,EAAZ,YAAY;oBACT,KAAI,CAAJ,CAAA,IAAG,CAAC;oBACH,MAAG,CAAH,CAAA,GAAE,CAAC,GAEnB,EARC,IAAI;;;;;;;;;;;0BASL,wOAAA,GAGM;