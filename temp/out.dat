./.next/dev/static/chunks/Projects_property-pulse-nextjs_b4160f05._.js.map:    {"offset": {"line": 4, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/utils/SuccessToast.ts"],"sourcesContent":["\"use client\";\nimport { useEffect } from \"react\";\nimport { useSearchParams, useRouter } from \"next/navigation\";\nimport { toast } from \"react-toastify\";\n\nexport default function SuccessToast() {\n    const searchParams = useSearchParams();\n    const router = useRouter();\n    useEffect(() => {\n        const toastMessages: Record<string, string> = {\n            property_created: \"Property created successful!!!\",\n            property_updated: \"Property updated successful!!!\"\n        };\n        const toastKey = searchParams.get(\"toast\");\n        if (toastKey && toastMessages[toastKey]) {\n            toast.success(toastMessages[toastKey]);\n        }\n        // Remove the query param from the URL without refreshing the page\n        const newSearchParams = new URLSearchParams(searchParams.toString());\n        newSearchParams.delete(\"toast\");\n\n        // Replace the URL\n        router.replace(`${window.location.pathname}?${newSearchParams.toString()}`);\n    }, [searchParams, router]);\n    return null;\n}"],"names":["c","_c","useEffect","useSearchParams","useRouter","toast","SuccessToast","$","$i","Symbol","for","searchParams","router","t0","t1","SuccessToast[useEffect()]","toastMessages","property_created","property_updated","toastKey","get","success","newSearchParams","URLSearchParams","toString","delete","replace","window","location","pathname"],"mappings":";;;;AAAa,SAAAA,CAAA,IAAAC,EAAA;AACb,SAASC,SAAS,QAAQ,OAAO;AACjC,SAASC,eAAe,EAAEC,SAAS,QAAQ,iBAAiB;AAC5D,SAASC,KAAK,QAAQ,gBAAgB;;AAHtC,YAAY;;;;;AAKG;;IAAA,MAAAE,CAAA,OAAAN,2NAAA,EAAA;IAAA,IAAAM,CAAA,CAAA,EAAA,KAAA,oEAAA;QAAA,IAAA,IAAAC,EAAA,GAAA,GAAAA,EAAA,GAAA,GAAAA,EAAA,IAAA,EAAA;YAAAD,CAAA,CAAAC,EAAA,CAAA,GAAAC,MAAA,CAAAC,GAAA,CAAA;QAAA;QAAA