./.next/dev/static/chunks/Projects_property-pulse-nextjs_1d1c643e._.js.map:    {"offset": {"line": 477, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/components/ShareButtons.tsx"],"sourcesContent":["\"use client\";\nimport {\n    FacebookShareButton, FacebookIcon,\n    TwitterShareButton, TwitterIcon,\n    WhatsappShareButton, WhatsappIcon,\n    EmailShareButton, EmailIcon\n} from 'react-share';\ntype ShareButtonsProps = {\n    property: {\n        _id: number|string;\n        name: string;\n        type: string;\n    }\n};\n\nconst ShareButtons = ({ property }: ShareButtonsProps) => {\n    const shareUrl = `${process.env.NEXT_PUBLIC_DOMAIN}/properties/${property._id}`;\n    return (\n        <>\n            <h3 className=\"text-xl font-bold text-center pt-2\">\n                Share This Property\n            </h3>\n            <div className=\"flex gap-3 justify-center pb-5\">\n                <FacebookShareButton\n                    url={shareUrl}\n                    quote={property.name}\n                    hashtag={`#${property.type.replace(/\\s/g, '')}ForRent`}\n                >\n                    <FacebookIcon size={40} round={true}/>\n                </FacebookShareButton>\n                <TwitterShareButton\n                    url={shareUrl}\n                    title={property.name}\n                    hashtags={[`${property.type.replace(/\\s/g, '')}`, 'ForRent']}\n                >\n                    <TwitterIcon size={40} round={true}/>\n                </TwitterShareButton>\n                <WhatsappShareButton\n                    url={shareUrl}\n                    title={property.name}\n                    separator='::'\n                >\n                    <WhatsappIcon size={40} round={true}/>\n                </WhatsappShareButton>\n                <EmailShareButton\n                    url={shareUrl}\n                    subject={property.name}\n                    body={`Check out this property list : ${shareUrl}`}\n                >\n                    <EmailIcon size={40} round={true}/>\n                </EmailShareButton>\n            </div>\n        </>\n    );\n}\n\nexport default ShareButtons;"],"names":["c","_c","FacebookShareButton","FacebookIcon","TwitterShareButton","TwitterIcon","WhatsappShareButton","WhatsappIcon","EmailShareButton","EmailIcon","ShareButtonsProps","property","_id","name","type","ShareButtons","t0","$","$i","Symbol","for","shareUrl","process","env","NEXT_PUBLIC_DOMAIN","t1","t2","t3","t4","replace","t5","t6","t7","t8","t9","t10","t11","t12","t13","t14","t15","t16","t17","t18"],"mappings":";;;;AAgBwBsB,OAAO,CAAAC,GAAI,CAAAC,kBAAmB;;AAhBzC,SAAAxB,CAAA,IAAAC,EAAA;AACb,SACIC,mBAAmB,EAAEC,YAAY,EACjCC,kBAAkB,EAAEC,WAAW,EAC/BC,mBAAmB,EAAEC,YAAY,EACjCC,gBAAgB,EAAEC,SAAS,QACxB,aAAa;AANpB,YAAY;;;;AAeZ,sBAAqBO,EAAA;IAAA,MAAAC,CAAA,GAAAhB,+NAAA,EAAA;IAAA,IAAAgB,CAAA,CAAA,EAAA,KAAA,oEAAA;QAAA,IAAA,IAAAC,EAAA,GAAA,GAAAA,EAAA,GAAA,IAAAA,EAAA,IAAA,EAAA;YAAAD,CAAA,CAAAC,EAAA,CAAA,GAAAC,MAAA,CAAAC,GAAA,CAAA;QAAA;QAAAH,CAAA,CAAA,EAAA,GAAA;IAAA;IAAC,MAAA,EAAAN,QAAAA,EAAA,GAAAK,EAA+B;IACjD,MAAAK,QAAA,GAAiB,6DAAiC,YAAA,EAAeV,QAAQ,CAAAC,GAAI,EAAE;IAAC,IAAAa,EAAA;IAAA,IAAAR,CAAA,CAAA,EAAA,KAAAE,MAAA,CAAAC,GAAA,CAAA,8BAAA;QAGxEK,EAAA,iBAAA,wOAAA,EAEK;YAFS,SAAoC,EAApC,oCAAoC;sBAAC,mBAEnD,EAFA,EAEK;;;;;;QAAAR,CAAA,CAAA,EAAA,GAAAQ,EAAA;IAAA,OAAA;QAAAA,EAAA,GAAAR,CAAA,CAAA,EAAA;IAAA;IAIU,MAAAS,EAAA,GAAAf,QAAQ,CAAAE,IAAK;IAAA,IAAAc,EAAA;IAAA,IAAAV,CAAA,CAAA,EAAA,KAAAN,QAAA,CAAAG,IAAA,EAAA;QAAA,IAAAc,EAAA;QAAA,IAAAX,CAAA,CAAA,EAAA,KAAAE,MAAA,CAAAC,GAAA,CAAA,8BAAA;YACeQ,EAAA,GAAA,KAAK;YAAAX,CAAA,CAAA,EAAA,GAAAW,EAAA;QAAA,OAAA;YAAAA,EAAA,GAAAX,CAAA,CAAA,EAAA;QAAA;QAA3BU,EAAA,GAAAhB,QAAQ,CAAAG,IAAK,CAAAe,OAAQ,CAACD,EAAK,EAAE,EAAE,CAAC;QAAAX,CAAA,CAAA,EAAA,GAAAN,QAAA,CAAAG,IAAA;QAAAG,CAAA,CAAA,EAAA,GAAAU,EAAA;IAAA,OAAA;QAAAA,EAAA,GAAAV,CAAA,CAAA,EAAA;IAAA;IAApC,MAAAW,EAAA,GAAA,CAAA,CAAA,EAAID,EAAgC,CAAA,OAAA,CAAS;IAAA,IAAAG,EAAA;IAAA,IAAAb,CAAA,