./.next/dev/static/chunks/Projects_property-pulse-nextjs_utils_SuccessToast_ts_e0d7fbfc._.js.map:    {"offset": {"line": 4, "column": 0}, "map": {"version":3,"sources":["file:///home/ndimangwa/Projects/property-pulse-nextjs/utils/SuccessToast.ts"],"sourcesContent":["\"use client\";\n\nimport { useEffect, useRef } from \"react\";\nimport { useSearchParams, useRouter } from \"next/navigation\";\nimport { toast } from \"react-toastify\";\n\nexport default function SuccessToast() {\n  const searchParams = useSearchParams();\n  const router = useRouter();\n  const hasShown = useRef(false); // prevents duplicate firing\n  \n  const PROPERTY_REACT_TOAST = \"toast\";\n\n  useEffect(() => {\n    if (hasShown.current) return;\n\n    const toastMessages: Record<string, string> = {\n      property_created: \"Property created successfully!\",\n      property_updated: \"Property updated successfully!\",\n    };\n\n    const toastKey = searchParams.get(PROPERTY_REACT_TOAST);\n\n    if (toastKey && toastMessages[toastKey]) {\n      hasShown.current = true; // mark as shown\n\n      toast.success(toastMessages[toastKey]);\n\n      // Remove query param safely\n      const newParams = new URLSearchParams(searchParams.toString());\n      newParams.delete(PROPERTY_REACT_TOAST);\n\n      router.replace(\n        `${window.location.pathname}${\n          newParams.toString() ? `?${newParams}` : \"\"\n        }`,\n        { scroll: false }\n      );\n    }\n  }, [searchParams, router]);\n\n  return null;\n}\n"],"names":["c","_c","useEffect","useRef","useSearchParams","useRouter","toast","SuccessToast","$","$i","Symbol","for","searchParams","router","hasShown","t0","t1","SuccessToast[useEffect()]","current","toastMessages","property_created","property_updated","toastKey","get","success","newParams","URLSearchParams","toString","delete","replace","window","location","pathname","scroll"],"mappings":";;;;AAAa,SAAAA,CAAA,IAAAC,EAAA;AAEb,SAASC,SAAS,EAAEC,MAAM,QAAQ,OAAO;AACzC,SAASC,eAAe,EAAEC,SA